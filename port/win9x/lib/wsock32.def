; WSOCK32.DEF
;
; The functions the Windows 95 build (port/dos/win95/w95_net.c) may import
; from WSOCK32.dll, Windows 95's own Winsock 1.1, which every later Windows
; keeps: the import library is made from this list (llvm-dlltool -k).
; Each is exported by name by Windows 95's WSOCK32.

LIBRARY WSOCK32.dll
EXPORTS
__WSAFDIsSet@8
accept@12
bind@12
closesocket@4
connect@12
gethostbyaddr@12
gethostbyname@4
gethostname@8
getpeername@12
getservbyname@8
getsockname@12
getsockopt@20
htonl@4
htons@4
inet_addr@4
inet_ntoa@4
ioctlsocket@12
listen@8
ntohl@4
ntohs@4
recv@16
recvfrom@24
select@20
send@16
sendto@24
setsockopt@20
shutdown@8
socket@12
WSACleanup@0
WSAGetLastError@0
WSASetLastError@4
WSAStartup@8
