DialogBoxIndirectParamA@20
DispatchMessageA@4
EmptyClipboard@0
EnableWindow@8
EndDialog@8
EndPaint@8
EnumDisplaySettingsA@12
FillRect@12
FrameRect@12
GetActiveWindow@0
GetAsyncKeyState@4
GetClientRect@8
GetClipboardData@4
GetClipCursor@4
GetCursorPos@4
GetDC@4
GetDesktopWindow@0
GetDlgItem@8
GetFocus@0
GetForegroundWindow@0
